# Copy to alerts/.env for local runs. On Railway, set the same names as Variables.
# Never commit a real webhook URL or user IDs.

# Channel webhook from your existing Discord server
# Server settings or channel settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx

# Optional. Leave empty for channel posts with no @mentions.
# DISCORD_USER_IDS=111111111111111111,222222222222222222

# Alert when a side's unfilled (resting book) $ jumps or drops by this much
ALERT_DELTA_USD=100000

# Ignore sides that never reach this $ (0 = off)
ALERT_MIN_SIDE_USD=0

# Cooldown per game+side+appear/drop so a flickering book does not spam
ALERT_COOLDOWN_MS=600000

# Poll interval
POLL_MS=45000

# Comma list. Default sports only. Add NBA,NHL,SOCCER,TENNIS if you want them.
KALSHI_SPORTS=NFL,NCAAF,MLB,WNBA
